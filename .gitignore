# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
dist/
dist-ssr/
build/
*.local
.vite/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test / coverage ---
coverage/
.nyc_output/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
.DS_Store
Thumbs.db
desktop.ini

# --- Financial data: never commit real CSVs ---
# Block every .csv in the repo; only anonymized fixtures are allowed.
*.csv
*.CSV
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.CSV
# Other common bank export formats
*.ofx
*.qfx
*.qif
*.xlsx
*.xls

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
secrets.*
credentials.*
.secrets
.netrc

# --- SSH keys ---
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
known_hosts
.ssh/

# --- Deploy config with host details (keep a committed *.example instead) ---
deploy.config
deploy.config.*
!deploy.config.example
